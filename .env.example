# PATH: GovScheme/.env.example
# Copy this file to ".env" and fill in real values. Never commit ".env".

# Flask
FLASK_SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# Database
DATABASE_PATH=database/SmartGov_AI.db

# ML
ML_MODEL_PATH=ml_models/trained_model.joblib

# Optional external services (leave blank to use local/offline fallbacks)
# If these are blank, SmartGov AI automatically uses the local rule-based
# chatbot and text-only chat (no crash, no fake behaviour).
LLM_API_KEY=
LLM_PROVIDER=

STT_PROVIDER=
STT_API_KEY=

TTS_PROVIDER=
TTS_API_KEY=

# Scheduler
SCHEME_UPDATE_INTERVAL_HOURS=24

# RPA
RPA_MODE=DEMO
# RPA_MODE=DEMO  -> uses the built-in demo government portal simulator
# RPA_MODE=UIPATH -> attempts to trigger a local UiPath Robot/Orchestrator job
UIPATH_ORCHESTRATOR_URL=
UIPATH_ORCHESTRATOR_TENANT=
UIPATH_ORCHESTRATOR_CLIENT_ID=
UIPATH_ORCHESTRATOR_CLIENT_SECRET=
